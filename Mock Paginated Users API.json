    {
      "parameters": {
        "jsCode": "\nconst query = $input.first().json.query || {};\n\nconst page = Math.max(1, Number(query.page || 1));\nconst limit = Math.max(1, Number(query.limit || 10));\n\nconst users = [];\n\nfor (let i = 1; i <= 23; i++) {\n  users.push({\n    id: i,\n    name: `User ${i}`,\n    email: i === 13\n      ? \"bad-email-format\"\n      : `user${i}@enterprise-test.io`,\n    department: i % 2 === 0\n      ? \"Engineering\"\n      : \"Operations\"\n  });\n}\n\nconst start = (page - 1) * limit;\nconst pageUsers = users.slice(start, start + limit);\n\nreturn [{\n  json: {\n    items: pageUsers,\n    currentPage: page,\n    returnedCount: pageUsers.length\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
