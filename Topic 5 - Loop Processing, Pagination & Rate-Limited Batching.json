      "parameters": {
        "jsCode": "\n\nconst state = $getWorkflowStaticData('global');\nconst config = $('Set Config').first().json;\n\nstate.currentPage = 1;\nstate.accumulatedUsers = [];\n\nreturn [{\n  json: {\n    currentPage: 1,\n    pageSize: Number(config.pageSize),\n    maxPages: Number(config.maxPages)\n  }\n}];\n"
      },
