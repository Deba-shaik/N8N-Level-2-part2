    },
    {
      "parameters": {
        "jsCode": "\n\n\n\n\nconst state = $getWorkflowStaticData('global');\nconst config = $('Set Config').first().json;\n\nconst users = $input.all().flatMap(item => {\n  const data = item.json;\n  return Array.isArray(data.items)\n    ? data.items\n    : data.id !== undefined ? [data] : [];\n});\n\nstate.accumulatedUsers ??= [];\nstate.currentPage ??= 1;\n\nstate.accumulatedUsers.push(...users);\nstate.currentPage++;\n\nif (state.currentPage > Number(config.maxPages || 10)) {\n  throw new Error(\n    `Maximum page limit reached. Current page: ${state.currentPage}`\n  );\n}\n\nreturn [{\n  json: {\n    currentPage: state.currentPage,\n    pageSize: Number(config.pageSize),\n    totalAccumulated: state.accumulatedUsers.length\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        -224
      ],
      "id": "7f0f1024-29f6-4850-b32e-63c114bf1b2c",
      "name": "Code_AccumulatePage"
    },
    {
      "parameters": {
        "jsCode": "\nconst state = $getWorkflowStaticData('global');\n\nconst users = state.accumulatedUsers || [];\n\nreturn users.map(user => ({\n  json: user\n}));\n"
      },
