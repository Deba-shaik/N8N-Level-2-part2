      ],
      "id": "b97ae703-766d-47ef-be23-bdf37321a068",
      "name": "Wait_RateLimitPause",
      "webhookId": "6f92ae48-3f48-4a57-a789-eeba789d3b0c"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all().map(item => item.json);\n\nconst sent = items.filter(i => i.status === \"SENT\").length;\nconst failed = items.filter(i => i.status === \"FAILED\").length;\n\nreturn [{\n  json: {\n    totalProcessed: items.length,\n    sent: sent,\n    failed: failed,\n    totalBatches: Math.ceil(items.length / 5),\n    status: \"COMPLETED\",\n    completedAt: new Date().toISOString()\n  }\n}];\n"
      },
