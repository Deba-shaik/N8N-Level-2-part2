    {
      "parameters": {
        "method": "POST",
        "url": "https://jsonplaceholder.typicode.com/posts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=\n\n{{ JSON.stringify({\n  \"to\": $json.email,\n  \"name\": $json.name,\n  \"subject\": \"Enterprise Operations Update\"\n}) }}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        544,
        -128
      ],
      "id": "cd142ea8-4091-469c-9e75-fa00c46ff818",
      "name": "HTTP_SendSimulatedEmail",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n\nreturn $input.all().map(item => {\n  const data = item.json;\n  const email = data.to || \"\";\n\n  const validEmail =\n    /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n  const failed =\n    !validEmail ||\n    Boolean(data.error) ||\n    Number(data.statusCode || 0) >= 400;\n\n  return {\n    json: {\n      email,\n      name: data.name || \"\",\n      status: failed ? \"FAILED\" : \"SENT\",\n      error: failed ? \"Invalid email or API error\" : null,\n      processedAt: new Date().toISOString()\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        -128
      ],
      "id": "223a5a8b-d7d8-4601-b120-6b7b7831a37b",
      "name": "Code_ClassifyResult"
    },
    {
